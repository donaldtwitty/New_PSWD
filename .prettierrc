{
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "htmlWhitespaceSensitivity": "ignore",
    "overrides": [
        {
            "files": "*.{yml,yaml}",
            "options": { "tabWidth": 2, "singleQuote": false }
        }
    ]
}
