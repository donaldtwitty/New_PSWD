{#
    Base layout for every page.

    Page front matter:
      title          <title> and share title (required)
      description    meta description (required, except on the 404 page)
      noindex        true keeps the page out of search results (404 page)
      structuredData true adds the business details for Google (home page)
      closer         false hides the "Ready to see what your site could do?" band
      scripts        extra files in assets/js/ to load, for example ["contact-form.js"]
#}
{%- set pageUrl = site.url + page.url -%}
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <script>
            document.documentElement.classList.add('js');
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{{ title }}</title>
        {%- if noindex %}
        <meta name="robots" content="noindex" />
        {%- else %}
        <meta name="description" content="{{ description }}" />
        <link rel="canonical" href="{{ pageUrl }}" />
        {%- endif %}
        <meta name="theme-color" content="{{ site.themeColor }}" />
        {%- if not noindex %}
        {% include "partials/share-meta.njk" %}
        {%- endif %}
        <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
        <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="/assets/css/styles.css" />
        {%- if site.analytics.goatcounterCode %}
        {# Privacy-friendly visit counts: no cookies, no personal data #}
        <script
            data-goatcounter="https://{{ site.analytics.goatcounterCode }}.goatcounter.com/count"
            async
            src="https://gc.zgo.at/count.js"
        ></script>
        {%- endif %}
        {%- if structuredData %}
        {% include "partials/structured-data.njk" %}
        {%- endif %}
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to main content</a>

        {% include "partials/header.njk" %}

        <main id="main">
            {{ content | safe }}
        </main>
        {% if closer %}
        {% include "partials/closer.njk" %}
        {% endif %}
        {% include "partials/footer.njk" %}
        {%- for script in scripts %}
        <script src="/assets/js/{{ script }}" defer></script>
        {%- endfor %}
        <script src="/assets/js/nav.js" defer></script>
    </body>
</html>
