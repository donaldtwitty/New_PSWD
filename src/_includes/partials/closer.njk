{# Closing call to action above the footer. Turn it off on a page with closer: false. #}
<div class="band closer" id="closer">
    <div class="container">
        <h2>Ready to see what your site could do?</h2>
        <div class="cta-row">
            <a class="btn" href="{{ site.cta.url }}">Get a free site review</a>
            {%- if site.bookingUrl %}
            <a class="btn btn--ghost" href="{{ site.bookingUrl }}" target="_blank" rel="noopener">Book a free call</a>
            {%- endif %}
        </div>
    </div>
</div>
